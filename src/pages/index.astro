---
import Layout from '../layouts/Layout.astro';
---

<Layout>

	<!-- ─── FONTS ─── -->
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

	<!-- ─── NAV ─── -->
		<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-10 py-4 bg-[rgba(6,26,46,0.85)] backdrop-blur-xl border-b border-white/8 transition-all duration-300">
		<a href="#hero" class="flex items-center gap-3 no-underline">
			<svg class="w-9 h-9" viewBox="0 0 38 38" fill="none">
			<circle cx="19" cy="19" r="19" fill="rgba(29,154,78,0.2)"/>
			<circle cx="19" cy="19" r="5" fill="#27c45f"/>
			<rect x="4" y="17" width="10" height="4" rx="2" fill="#27c45f"/>
			<rect x="24" y="17" width="10" height="4" rx="2" fill="#27c45f"/>
			<rect x="17" y="4" width="4" height="10" rx="2" fill="#41b3f5"/>
			<rect x="17" y="24" width="4" height="10" rx="2" fill="#41b3f5"/>
			<circle cx="7" cy="7" r="3" fill="rgba(39,196,95,0.5)"/>
			<circle cx="31" cy="7" r="3" fill="rgba(39,196,95,0.5)"/>
			<circle cx="7" cy="31" r="3" fill="rgba(65,179,245,0.5)"/>
			<circle cx="31" cy="31" r="3" fill="rgba(65,179,245,0.5)"/>
			</svg>
			<span class="font-['Bebas_Neue'] text-2xl tracking-widest text-white leading-none">Agro<span class="text-[#27c45f]">Evolution</span></span>
		</a>

		<ul class="hidden md:flex gap-8 list-none">
			<li><a href="#servicios" class="text-white/80 no-underline text-sm font-medium tracking-wide hover:text-[#27c45f] transition-colors duration-300">Servicios</a></li>
			<li><a href="#como-funciona" class="text-white/80 no-underline text-sm font-medium tracking-wide hover:text-[#27c45f] transition-colors duration-300">Tecnología</a></li>
			<li><a href="#galeria" class="text-white/80 no-underline text-sm font-medium tracking-wide hover:text-[#27c45f] transition-colors duration-300">Galería</a></li>
			<li><a href="#nosotros" class="text-white/80 no-underline text-sm font-medium tracking-wide hover:text-[#27c45f] transition-colors duration-300">Nosotros</a></li>
			<li><a href="#contacto" class="bg-[#1d9a4e] text-white no-underline text-sm font-bold tracking-wide px-5 py-2 rounded-full hover:bg-[#27c45f] hover:-translate-y-0.5 transition-all duration-300">Cotizar</a></li>
		</ul>

		<button id="hamburger" class="md:hidden flex flex-col gap-1.5 bg-transparent border-0 cursor-pointer p-1" aria-label="Menú">
			<span class="block w-6 h-0.5 bg-white rounded transition-all duration-300"></span>
			<span class="block w-6 h-0.5 bg-white rounded transition-all duration-300"></span>
			<span class="block w-6 h-0.5 bg-white rounded transition-all duration-300"></span>
		</button>
	</nav>

	<!-- Mobile menu -->
	<div id="mobileMenu" class="hidden fixed top-[68px] left-0 right-0 z-40 bg-[rgba(6,26,46,0.97)] backdrop-blur-xl flex-col gap-0 md:hidden">
		<a href="#servicios" onclick="closeMobile()" class="text-white/85 no-underline text-lg font-medium px-6 py-4 border-b border-white/8 hover:text-[#27c45f] transition-colors block">Servicios</a>
		<a href="#como-funciona" onclick="closeMobile()" class="text-white/85 no-underline text-lg font-medium px-6 py-4 border-b border-white/8 hover:text-[#27c45f] transition-colors block">Tecnología</a>
		<a href="#galeria" onclick="closeMobile()" class="text-white/85 no-underline text-lg font-medium px-6 py-4 border-b border-white/8 hover:text-[#27c45f] transition-colors block">Galería</a>
		<a href="#nosotros" onclick="closeMobile()" class="text-white/85 no-underline text-lg font-medium px-6 py-4 border-b border-white/8 hover:text-[#27c45f] transition-colors block">Nosotros</a>
		<a href="#contacto" onclick="closeMobile()" class="text-[#27c45f] no-underline text-lg font-bold px-6 py-4 block">Cotizar ahora →</a>
	</div>

	<!-- ─── HERO (video background) ─── -->
	<section id="hero" class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-[#061a2e]">

		<!-- VIDEO BG — reemplazá el src con tu video real -->
		<video
			id="heroVideo"
			class="absolute inset-0 w-full h-full object-cover opacity-40"
			autoplay muted loop playsinline
			poster="/dronFumigando.webp"
		>
			<!-- Pone tu video acá: /videos/drone-campo.mp4 -->
			<source src="/fumigando.mp4" type="video/mp4" />
		</video>

		<!-- Fallback image when video doesn't load -->
		<img
			id="heroFallback"
			src="/dronFumigando.webp"
			alt="Dron fumigando"
			class="absolute inset-0 w-full h-full object-cover opacity-35 hidden"
		/>

		<!-- Gradient overlays -->
		<div class="absolute inset-0 bg-gradient-to-b from-[#061a2e]/60 via-transparent to-[#061a2e]/80 pointer-events-none"></div>
		<div class="absolute inset-0 bg-gradient-to-r from-[#061a2e]/50 via-transparent to-transparent pointer-events-none"></div>

		<!-- Grid overlay -->
		<div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(39,196,95,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(39,196,95,0.05) 1px, transparent 1px); background-size: 60px 60px; animation: gridFloat 20s linear infinite;"></div>

		<!-- Glow -->
		<div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] pointer-events-none" style="background: radial-gradient(ellipse, rgba(29,154,78,0.3) 0%, transparent 70%);"></div>

		<!-- Content -->
		<div class="relative z-10 max-w-4xl w-full px-6 md:px-10 pt-28 pb-40 animate-heroFade">
			<div class="inline-flex items-center gap-2 bg-[rgba(39,196,95,0.15)] border border-[rgba(39,196,95,0.4)] text-[#27c45f] text-xs font-bold tracking-[0.12em] uppercase px-4 py-1.5 rounded-full mb-6">
				<span class="w-1.5 h-1.5 bg-[#27c45f] rounded-full animate-pulse"></span>
				DJI Agras T100 · Río Segundo, Córdoba
			</div>
			<h1 class="font-['Bebas_Neue'] text-[clamp(3.2rem,10vw,7.5rem)] leading-[0.9] tracking-wide text-white mb-6">
				AGRICULTURA<br>
				DE <span class="text-[#27c45f]">PRECISIÓN</span><br>
				<span class="text-[#41b3f5]">DESDE EL AIRE</span>
			</h1>
			<p class="text-white/70 text-[clamp(1rem,2.2vw,1.2rem)] leading-relaxed max-w-xl font-light mb-8">
			Fumigación, fertilización y siembra con drones de última generación. Más eficiencia, menos químicos, mayor rendimiento para tu campo.
			</p>
			<div class="flex flex-wrap gap-4 items-center">
				<a href="#contacto" class="inline-flex items-center gap-2 bg-[#1d9a4e] text-white font-bold text-base px-7 py-3.5 rounded-full no-underline hover:bg-[#27c45f] hover:-translate-y-0.5 transition-all duration-300 shadow-[0_4px_24px_rgba(29,154,78,0.4)]">
					<svg viewBox="0 0 20 20" fill="none" class="w-4 h-4"><path d="M2 5a2 2 0 012-2h12a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm3.293 1.293a1 1 0 011.414 0L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" fill="white"/></svg>
					Solicitar cotización
				</a>
				<a href="#como-funciona" class="inline-flex items-center gap-2 bg-transparent text-white/85 font-semibold text-sm px-6 py-3.5 rounded-full no-underline border border-white/30 hover:border-[#41b3f5] hover:text-[#41b3f5] hover:-translate-y-0.5 transition-all duration-300">
					Ver tecnología →
				</a>
			</div>
		</div>

		<!-- Stats bar -->
		<div class="absolute bottom-0 left-0 right-0 z-10">
			<div class="flex justify-center gap-8 sm:gap-16 py-5 px-6 bg-gradient-to-t from-[#061a2e] to-transparent">
				<div class="text-center">
					<div class="font-['Bebas_Neue'] text-[clamp(1.8rem,4vw,2.8rem)] text-[#27c45f] leading-none tracking-wide">100HA</div>
					<div class="text-[0.68rem] text-white/50 uppercase tracking-widest mt-0.5">por jornada</div>
				</div>
				<div class="text-center">
					<div class="font-['Bebas_Neue'] text-[clamp(1.8rem,4vw,2.8rem)] text-[#27c45f] leading-none tracking-wide">40L</div>
					<div class="text-[0.68rem] text-white/50 uppercase tracking-widest mt-0.5">capacidad</div>
				</div>
				<div class="text-center">
					<div class="font-['Bebas_Neue'] text-[clamp(1.8rem,4vw,2.8rem)] text-[#27c45f] leading-none tracking-wide">3X</div>
					<div class="text-[0.68rem] text-white/50 uppercase tracking-widest mt-0.5">más veloz</div>
				</div>
				<div class="text-center hidden sm:block">
					<div class="font-['Bebas_Neue'] text-[clamp(1.8rem,4vw,2.8rem)] text-[#27c45f] leading-none tracking-wide">0</div>
					<div class="text-[0.68rem] text-white/50 uppercase tracking-widest mt-0.5">pisoteo</div>
				</div>
			</div>
		</div>

		<!-- Scroll indicator -->
		<div class="absolute bottom-20 left-1/2 -translate-x-1/2 z-10 animate-bounce">
			<div class="w-5 h-5 border-r-2 border-b-2 border-white/35 rotate-45"></div>
		</div>
	</section>


	<!-- ─── SERVICES ─── -->
	<section id="servicios" class="py-24 px-6 md:px-10 bg-white">
		<div class="max-w-6xl mx-auto">
			<div class="reveal mb-14">
				<span class="inline-block font-['Space_Mono'] text-[0.72rem] tracking-[0.2em] uppercase text-[#1d9a4e] mb-3">Nuestros servicios</span>
				<h2 class="font-['Bebas_Neue'] text-[clamp(2.4rem,5vw,4rem)] leading-none tracking-wide text-[#0d1a10] mb-4">SOLUCIONES <span class="text-[#1d9a4e]">AÉREAS</span><br>PARA TU CAMPO</h2>
				<p class="text-[#4a6358] text-base leading-relaxed max-w-lg">Servicios agrícolas completos con tecnología de drones DJI Agras T100, el estándar más avanzado del mercado.</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
			<!-- Fitosanitarios -->
				<div class="reveal bg-[#f4f7f2] border border-[rgba(29,154,78,0.12)] rounded-xl p-7 relative overflow-hidden group hover:-translate-y-1.5 hover:shadow-[0_20px_50px_rgba(29,154,78,0.12)] hover:border-[#1d9a4e] transition-all duration-300">
					<div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#0a3d1f] to-[#145a32] flex items-center justify-center mb-5 shadow-[0_6px_20px_rgba(10,61,31,0.25)]">
						<svg viewBox="0 0 28 28" fill="none" class="w-7 h-7">
							<path d="M14 3C8.477 3 4 7.477 4 13s4.477 10 10 10 10-4.477 10-10S19.523 3 14 3z" fill="rgba(39,196,95,0.2)" stroke="#27c45f" stroke-width="1.5"/>
							<path d="M10 14l3 3 5-6" stroke="#27c45f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
					<h3 class="font-['Bebas_Neue'] text-2xl tracking-wide text-[#0d1a10] mb-2">Fitosanitarios</h3>
					<p class="text-[#4a6358] text-sm leading-relaxed mb-4">Aplicación precisa de agroquímicos para el control de plagas, enfermedades y malezas. Cobertura uniforme con mínima deriva.</p>
					<span class="inline-block text-[0.7rem] font-bold uppercase tracking-wider text-[#1d9a4e] bg-[rgba(29,154,78,0.1)] px-3 py-1 rounded-full">Control de plagas</span>
				</div>

				<!-- Fertilización -->
				<div class="reveal bg-[#f4f7f2] border border-[rgba(29,154,78,0.12)] rounded-xl p-7 relative overflow-hidden group hover:-translate-y-1.5 hover:shadow-[0_20px_50px_rgba(29,154,78,0.12)] hover:border-[#1d9a4e] transition-all duration-300">
					<div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#0a3d1f] to-[#145a32] flex items-center justify-center mb-5 shadow-[0_6px_20px_rgba(10,61,31,0.25)]">
						<svg viewBox="0 0 28 28" fill="none" class="w-7 h-7">
							<path d="M14 4L6 14h16L14 4z" fill="rgba(65,179,245,0.2)" stroke="#41b3f5" stroke-width="1.5" stroke-linejoin="round"/>
							<rect x="9" y="14" width="10" height="9" rx="2" fill="rgba(65,179,245,0.1)" stroke="#41b3f5" stroke-width="1.5"/>
							<path d="M11 18h6M14 16v4" stroke="#41b3f5" stroke-width="1.5" stroke-linecap="round"/>
						</svg>
					</div>
					<h3 class="font-['Bebas_Neue'] text-2xl tracking-wide text-[#0d1a10] mb-2">Fertilización</h3>
					<p class="text-[#4a6358] text-sm leading-relaxed mb-4">Distribución homogénea de fertilizantes líquidos o sólidos con dosificación variable según mapa de rendimiento.</p>
					<span class="inline-block text-[0.7rem] font-bold uppercase tracking-wider text-[#1d9a4e] bg-[rgba(29,154,78,0.1)] px-3 py-1 rounded-full">Nutrición de cultivos</span>
				</div>

				<!-- Siembra -->
				<div class="reveal bg-[#f4f7f2] border border-[rgba(29,154,78,0.12)] rounded-xl p-7 relative overflow-hidden group hover:-translate-y-1.5 hover:shadow-[0_20px_50px_rgba(29,154,78,0.12)] hover:border-[#1d9a4e] transition-all duration-300">
					<div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#0a3d1f] to-[#145a32] flex items-center justify-center mb-5 shadow-[0_6px_20px_rgba(10,61,31,0.25)]">
						<svg viewBox="0 0 28 28" fill="none" class="w-7 h-7">
							<path d="M8 22C8 17 14 10 20 6" stroke="#e8b84b" stroke-width="2" stroke-linecap="round"/>
							<path d="M8 22c0-5 3-9 8-11" stroke="#e8b84b" stroke-width="1.5" stroke-linecap="round"/>
							<circle cx="20" cy="6" r="3" fill="rgba(232,184,75,0.3)" stroke="#e8b84b" stroke-width="1.5"/>
							<circle cx="8" cy="22" r="2" fill="#e8b84b"/>
						</svg>
					</div>
					<h3 class="font-['Bebas_Neue'] text-2xl tracking-wide text-[#0d1a10] mb-2">Siembra</h3>
					<p class="text-[#4a6358] text-sm leading-relaxed mb-4">Siembra aérea de semillas de pasturas, colza, arroz y otras especies en terrenos difíciles o inundables.</p>
					<span class="inline-block text-[0.7rem] font-bold uppercase tracking-wider text-[#1d9a4e] bg-[rgba(29,154,78,0.1)] px-3 py-1 rounded-full">Zonas difíciles</span>
				</div>

				<!-- Monitoreo -->
				<div class="reveal bg-[#f4f7f2] border border-[rgba(29,154,78,0.12)] rounded-xl p-7 relative overflow-hidden group hover:-translate-y-1.5 hover:shadow-[0_20px_50px_rgba(29,154,78,0.12)] hover:border-[#1d9a4e] transition-all duration-300">
					<div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#0a3d1f] to-[#145a32] flex items-center justify-center mb-5 shadow-[0_6px_20px_rgba(10,61,31,0.25)]">
						<svg viewBox="0 0 28 28" fill="none" class="w-7 h-7">
							<rect x="4" y="6" width="20" height="14" rx="3" fill="rgba(29,154,78,0.15)" stroke="#1d9a4e" stroke-width="1.5"/>
							<path d="M9 14l3-4 3 3 3-5" stroke="#1d9a4e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
					<h3 class="font-['Bebas_Neue'] text-2xl tracking-wide text-[#0d1a10] mb-2">Monitoreo NDVI</h3>
					<p class="text-[#4a6358] text-sm leading-relaxed mb-4">Relevamiento con análisis de índices de vegetación. Detección temprana de focos de plagas o estrés hídrico.</p>
					<span class="inline-block text-[0.7rem] font-bold uppercase tracking-wider text-[#1d9a4e] bg-[rgba(29,154,78,0.1)] px-3 py-1 rounded-full">Tecnología NDVI</span>
				</div>
			</div>

			<!-- Advantages strip -->
			<div class="reveal grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mt-12">
				{[
					['Sin pisoteo', 'Zero daño mecánico al cultivo'],
					['Menor insumo', 'Hasta 30% ahorro fitosanitarios'],
					['Velocidad', '100 hectáreas por jornada'],
					['Vuelo autónomo', 'GPS RTK precisión centimétrica'],
					['Zonas difíciles', 'Opera en terrenos anegados'],
				].map(([title, desc]) => (
					<div class="flex flex-col gap-2 bg-gradient-to-br from-[#0a3d1f] to-[#0d3320] rounded-xl p-4">
						<div class="w-6 h-6 bg-[rgba(39,196,95,0.2)] rounded-full flex items-center justify-center flex-shrink-0">
							<svg viewBox="0 0 14 14" fill="none" class="w-3.5 h-3.5"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="#27c45f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<h4 class="text-white text-sm font-bold">{title}</h4>
						<p class="text-white/55 text-[0.75rem] leading-snug">{desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>


	<!-- ─── HOW IT WORKS ─── -->
	<section id="como-funciona" class="py-24 px-6 md:px-10 relative overflow-hidden" style="background: linear-gradient(160deg, #061a2e 0%, #0a3d1f 100%);">
		<div class="max-w-6xl mx-auto">
			<div class="reveal mb-14">
				<span class="inline-block font-['Space_Mono'] text-[0.72rem] tracking-[0.2em] uppercase text-[#27c45f] mb-3">Cómo funciona</span>
				<h2 class="font-['Bebas_Neue'] text-[clamp(2.4rem,5vw,4rem)] leading-none tracking-wide text-white mb-4">TECNOLOGÍA QUE<br><span class="text-[#27c45f]">TRANSFORMA</span> EL CAMPO</h2>
				<p class="text-white/60 text-base leading-relaxed max-w-lg">Un proceso simple, rápido y altamente eficiente para proteger y potenciar tu producción.</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-16">
				{[
					['01', 'Planificación', 'Cargamos el polígono del lote. El drone mapea y planifica la trayectoria óptima con GPS RTK centimétrico.'],
					['02', 'Configuración', 'Cargamos el producto y calibramos dosis y caudal según la prescripción agronómica del lote.'],
					['03', 'Vuelo autónomo', 'El DJI Agras T100 aplica el producto en forma uniforme, manteniendo altura constante sobre el canopeo.'],
					['04', 'Reporte', 'Entregamos reporte con track GPS, producto aplicado, dosis y caudal. Total trazabilidad.'],
				].map(([num, title, desc]) => (
					<div class="reveal relative bg-white/5 border border-white/10 rounded-xl p-6 hover:bg-white/10 hover:-translate-y-1 transition-all duration-300">
					<span class="font-['Bebas_Neue'] text-6xl leading-none text-white/5 absolute top-3 right-4">{num}</span>
					<div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#1d9a4e] to-[#1565c0] flex items-center justify-center mb-4 shadow-[0_4px_20px_rgba(29,154,78,0.4)]">
						<span class="font-['Bebas_Neue'] text-white text-lg">{num}</span>
					</div>
					<h3 class="text-white font-bold text-base mb-2">{title}</h3>
					<p class="text-white/55 text-sm leading-relaxed">{desc}</p>
					</div>
				))}
			</div>

			<!-- Drone specs -->
			<div class="reveal bg-white/4 border border-white/10 rounded-2xl p-6 md:p-10 flex flex-col md:flex-row gap-8 items-start md:items-center">
				<div class="md:w-64">
					<h3 class="font-['Bebas_Neue'] text-2xl tracking-wide text-[#27c45f] mb-2">DJI AGRAS T100</h3>
					<p class="text-white/55 text-sm leading-relaxed">El drone agrícola más avanzado disponible. Diseñado para máxima eficiencia en grandes extensiones.</p>
				</div>
				<div class="flex-1 grid grid-cols-3 sm:grid-cols-3 lg:grid-cols-6 gap-3">
					{[
					['40L', 'Tanque'],
					['100ha', 'Por jornada'],
					['±10cm', 'GPS RTK'],
					['8 mts', 'Ancho labor'],
					['12L/min', 'Caudal máx'],
					['Auto', 'Autónomo'],
					].map(([val, label]) => (
					<div class="text-center p-3 bg-white/4 border border-white/8 rounded-xl">
						<span class="font-['Space_Mono'] text-[#41b3f5] font-bold text-base block mb-1">{val}</span>
						<span class="text-white/40 text-[0.65rem] uppercase tracking-wider">{label}</span>
					</div>
					))}
				</div>
			</div>
		</div>
	</section>


	<!-- ─── GALLERY ─── -->
	<section id="galeria" class="py-24 px-6 md:px-10 bg-[#0d1a10]">
		<div class="max-w-6xl mx-auto">
			<div class="reveal text-center mb-14">
				<span class="inline-block font-['Space_Mono'] text-[0.72rem] tracking-[0.2em] uppercase text-[#27c45f] mb-3">Galería</span>
				<h2 class="font-['Bebas_Neue'] text-[clamp(2.4rem,5vw,4rem)] leading-none tracking-wide text-white mb-4">NUESTROS <span class="text-[#27c45f]">DRONES</span><br>EN ACCIÓN</h2>
