---
import Layout from '../layouts/Layout.astro';
---

<Layout>

	<!-- ─── NAV ─── -->
	<nav id="navbar">
		<a href="#hero" class="nav-logo">
			<!-- Simple drone SVG logo -->
			<svg class="nav-logo-icon" viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg">
				<circle cx="19" cy="19" r="19" fill="rgba(29,154,78,0.2)"/>
				<circle cx="19" cy="19" r="5" fill="#27c45f"/>
				<rect x="4" y="17" width="10" height="4" rx="2" fill="#27c45f"/>
				<rect x="24" y="17" width="10" height="4" rx="2" fill="#27c45f"/>
				<rect x="17" y="4" width="4" height="10" rx="2" fill="#41b3f5"/>
				<rect x="17" y="24" width="4" height="10" rx="2" fill="#41b3f5"/>
				<circle cx="7" cy="7" r="3" fill="rgba(39,196,95,0.5)"/>
				<circle cx="31" cy="7" r="3" fill="rgba(39,196,95,0.5)"/>
				<circle cx="7" cy="31" r="3" fill="rgba(65,179,245,0.5)"/>
				<circle cx="31" cy="31" r="3" fill="rgba(65,179,245,0.5)"/>
			</svg>
			<span class="nav-logo-text">Agro<span>Evolution</span></span>
		</a>
		<ul class="nav-links">
			<li><a href="#servicios">Servicios</a></li>
			<li><a href="#como-funciona">Tecnología</a></li>
			<li><a href="#nosotros">Nosotros</a></li>
			<li><a href="#contacto" class="nav-cta">Cotizar</a></li>
		</ul>
		<button class="hamburger" id="hamburger" aria-label="Menú">
			<span></span><span></span><span></span>
		</button>
	</nav>
	<div class="mobile-menu" id="mobileMenu">
		<a href="#servicios" onclick="closeMobile()">Servicios</a>
		<a href="#como-funciona" onclick="closeMobile()">Tecnología</a>
		<a href="#nosotros" onclick="closeMobile()">Nosotros</a>
		<a href="#contacto" onclick="closeMobile()" style="color:var(--green-bright)">Cotizar ahora →</a>
	</div>

	<!-- ─── HERO ─── -->
	<section id="hero">
		<div class="hero-grid-overlay"></div>
		<div class="hero-glow"></div>

		<!-- Large drone SVG background illustration -->
		<svg class="hero-drone-illustration" viewBox="0 0 900 600" fill="none" xmlns="http://www.w3.org/2000/svg">
			<ellipse cx="450" cy="320" rx="160" ry="12" fill="rgba(39,196,95,0.15)"/>
			<rect x="330" y="280" width="240" height="80" rx="18" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
			<circle cx="450" cy="320" r="30" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
			<circle cx="450" cy="320" r="15" fill="rgba(39,196,95,0.3)" stroke="#27c45f" stroke-width="1.5"/>
			<!-- arms -->
			<line x1="330" y1="295" x2="140" y2="190" stroke="rgba(255,255,255,0.15)" stroke-width="6" stroke-linecap="round"/>
			<line x1="570" y1="295" x2="760" y2="190" stroke="rgba(255,255,255,0.15)" stroke-width="6" stroke-linecap="round"/>
			<line x1="330" y1="345" x2="140" y2="450" stroke="rgba(255,255,255,0.15)" stroke-width="6" stroke-linecap="round"/>
			<line x1="570" y1="345" x2="760" y2="450" stroke="rgba(255,255,255,0.15)" stroke-width="6" stroke-linecap="round"/>
			<!-- motors -->
			<circle cx="140" cy="190" r="45" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>
			<circle cx="760" cy="190" r="45" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>
			<circle cx="140" cy="450" r="45" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>
			<circle cx="760" cy="450" r="45" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>
			<!-- propellers -->
			<ellipse cx="140" cy="190" rx="80" ry="6" fill="rgba(39,196,95,0.18)" stroke="rgba(39,196,95,0.3)" stroke-width="1"/>
			<ellipse cx="760" cy="190" rx="80" ry="6" fill="rgba(39,196,95,0.18)" stroke="rgba(39,196,95,0.3)" stroke-width="1"/>
			<ellipse cx="140" cy="450" rx="80" ry="6" fill="rgba(65,179,245,0.18)" stroke="rgba(65,179,245,0.3)" stroke-width="1"/>
			<ellipse cx="760" cy="450" rx="80" ry="6" fill="rgba(65,179,245,0.18)" stroke="rgba(65,179,245,0.3)" stroke-width="1"/>
			<!-- spray droplets -->
			<circle cx="380" cy="420" r="4" fill="rgba(65,179,245,0.4)"/>
			<circle cx="420" cy="450" r="3" fill="rgba(65,179,245,0.3)"/>
			<circle cx="450" cy="435" r="5" fill="rgba(65,179,245,0.5)"/>
			<circle cx="480" cy="460" r="3" fill="rgba(65,179,245,0.3)"/>
			<circle cx="520" cy="440" r="4" fill="rgba(65,179,245,0.4)"/>
			<circle cx="360" cy="460" r="3" fill="rgba(65,179,245,0.25)"/>
			<circle cx="540" cy="465" r="3" fill="rgba(65,179,245,0.25)"/>
		</svg>

		<div class="hero-content">
			<div class="hero-badge">DJI Agras T100 · Río Segundo, Córdoba</div>
			<h1 class="hero-title">
				AGRICULTURA<br>
				DE <span class="accent">PRECISIÓN</span><br>
				<span class="accent2">DESDE EL AIRE</span>
			</h1>
			<p class="hero-subtitle">
			Fumigación, fertilización y siembra con drones de última generación. Más eficiencia, menos químicos, mayor rendimiento para tu campo.
			</p>
			<div class="hero-buttons">
				<a href="#contacto" class="btn-primary">
					<svg viewBox="0 0 20 20" fill="none" width="18" height="18"><path d="M2 5a2 2 0 012-2h12a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm3.293 1.293a1 1 0 011.414 0L10 9.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" fill="white"/></svg>
					Solicitar cotización
				</a>
				<a href="#como-funciona" class="btn-secondary">
					Ver tecnología →
				</a>
			</div>
		</div>

		<div class="hero-stats pt-10">
			<div class="hero-stat">
				<div class="hero-stat-num">100HA</div>
				<div class="hero-stat-label">por jornada</div>
			</div>
			<div class="hero-stat">
				<div class="hero-stat-num">40L</div>
				<div class="hero-stat-label">capacidad tanque</div>
			</div>
			<div class="hero-stat">
				<div class="hero-stat-num">3X</div>
				<div class="hero-stat-label">más veloz</div>
			</div>
			<div class="hero-stat">
				<div class="hero-stat-num">0</div>
				<div class="hero-stat-label">pisoteo de cultivos</div>
			</div>
		</div>

		<div class="hero-scroll" aria-hidden="true">
			<div class="scroll-arrow"></div>
		</div>
	</section>

	<!-- ─── SERVICES ─── -->
	<section id="servicios">
	<div class="container">
		<div class="reveal">
		<span class="section-label">Nuestros servicios</span>
		<h2 class="section-title">SOLUCIONES <span class="accent">AÉREAS</span><br>PARA TU CAMPO</h2>
		<p class="section-subtitle">Ofrecemos servicios agrícolas completos con tecnología de drones DJI Agras T100, el estándar más avanzado del mercado.</p>
		</div>

		<div class="services-grid">
		<!-- Fitosanitarios -->
		<div class="service-card reveal">
			<div class="service-icon-wrap">
			<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M14 3C8.477 3 4 7.477 4 13s4.477 10 10 10 10-4.477 10-10S19.523 3 14 3z" fill="rgba(39,196,95,0.2)" stroke="#27c45f" stroke-width="1.5"/>
				<path d="M10 14l3 3 5-6" stroke="#27c45f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				<path d="M14 8v2M14 18v2M8 13h2M18 13h2" stroke="rgba(39,196,95,0.6)" stroke-width="1.5" stroke-linecap="round"/>
			</svg>
			</div>
			<h3>Fitosanitarios</h3>
			<p>Aplicación precisa de agroquímicos para el control de plagas, enfermedades y malezas. Cobertura uniforme con gotas calibradas y mínima deriva.</p>
			<span class="service-tag">Control de plagas</span>
		</div>

		<!-- Fertilización -->
		<div class="service-card reveal">
			<div class="service-icon-wrap">
			<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M14 4L6 14h16L14 4z" fill="rgba(65,179,245,0.2)" stroke="#41b3f5" stroke-width="1.5" stroke-linejoin="round"/>
				<rect x="9" y="14" width="10" height="9" rx="2" fill="rgba(65,179,245,0.1)" stroke="#41b3f5" stroke-width="1.5"/>
				<path d="M11 18h6M14 16v4" stroke="#41b3f5" stroke-width="1.5" stroke-linecap="round"/>
			</svg>
			</div>
			<h3>Fertilización</h3>
			<p>Distribución homogénea de fertilizantes líquidos o sólidos con dosificación variable según mapa de rendimiento. Máximo aprovechamiento nutricional.</p>
			<span class="service-tag">Nutrición de cultivos</span>
		</div>

		<!-- Siembra -->
		<div class="service-card reveal">
			<div class="service-icon-wrap">
			<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M8 22C8 17 14 10 20 6" stroke="#e8b84b" stroke-width="2" stroke-linecap="round"/>
				<path d="M8 22c0-5 3-9 8-11" stroke="#e8b84b" stroke-width="1.5" stroke-linecap="round"/>
				<circle cx="20" cy="6" r="3" fill="rgba(232,184,75,0.3)" stroke="#e8b84b" stroke-width="1.5"/>
				<circle cx="8" cy="22" r="2" fill="#e8b84b"/>
				<path d="M12 20l1.5-2M16 17l1-2" stroke="rgba(232,184,75,0.6)" stroke-width="1.5" stroke-linecap="round"/>
			</svg>
			</div>
			<h3>Siembra</h3>
			<p>Siembra aérea de semillas de pasturas, colza, arroz y otras especies en terrenos difíciles o inundables. Ideal para zonas de difícil acceso terrestre.</p>
			<span class="service-tag">Acceso a zonas difíciles</span>
		</div>

		<!-- Monitoreo -->
		<div class="service-card reveal">
			<div class="service-icon-wrap">
			<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
				<rect x="4" y="6" width="20" height="14" rx="3" fill="rgba(29,154,78,0.15)" stroke="#1d9a4e" stroke-width="1.5"/>
				<path d="M9 14l3-4 3 3 3-5" stroke="#1d9a4e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
				<path d="M10 22h8" stroke="#1d9a4e" stroke-width="1.5" stroke-linecap="round"/>
				<path d="M14 20v2" stroke="#1d9a4e" stroke-width="1.5" stroke-linecap="round"/>
			</svg>
			</div>
			<h3>Monitoreo y Mapeo</h3>
			<p>Relevamiento aéreo de cultivos con análisis de índices de vegetación (NDVI). Detección temprana de focos de plagas, enfermedades o estrés hídrico.</p>
			<span class="service-tag">Tecnología NDVI</span>
		</div>
		</div>

		<!-- Advantages -->
		<div class="advantages-strip">
		<div class="adv-item reveal">
			<div class="adv-check">
			<svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="#27c45f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
			<div>
			<h4>Sin pisoteo</h4>
			<p>Zero daño mecánico al cultivo ni compactación del suelo</p>
			</div>
		</div>
		<div class="adv-item reveal">
			<div class="adv-check">
			<svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="#27c45f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
			<div>
			<h4>Menor insumo</h4>
			<p>Hasta 30% de ahorro en productos fitosanitarios</p>
			</div>
		</div>
		<div class="adv-item reveal">
			<div class="adv-check">
			<svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="#27c45f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
			<div>
			<h4>Velocidad</h4>
			<p>100 hectáreas por jornada de trabajo</p>
			</div>
		</div>
		<div class="adv-item reveal">
			<div class="adv-check">
			<svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="#27c45f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
			<div>
			<h4>Vuelo autónomo</h4>
			<p>GPS RTK con precisión centimétrica</p>
			</div>
		</div>
		<div class="adv-item reveal">
			<div class="adv-check">
			<svg viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="#27c45f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</div>
			<div>
			<h4>Terrenos difíciles</h4>
			<p>Opera en zonas anegadas o de pendiente</p>
			</div>
		</div>
		</div>
	</div>
	</section>

	<!-- ─── HOW IT WORKS ─── -->
	<section id="como-funciona" class="como-funciona">
		<div class="container">
			<div class="reveal">
				<span class="section-label" style="color:var(--green-bright)">Cómo funciona</span>
				<h2 class="section-title" style="color:#fff">TECNOLOGÍA QUE<br><span style="color:var(--green-bright)">TRANSFORMA</span> EL CAMPO</h2>
				<p class="section-subtitle">Un proceso simple, rápido y altamente eficiente para proteger y potenciar tu producción.</p>
			</div>

			<div class="steps-container">
				<div class="step-card reveal">
					<div class="step-number">01</div>
					<div class="step-dot">
						<svg viewBox="0 0 24 24" fill="none"><path d="M9 20H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v3" stroke="white" stroke-width="1.8" stroke-linecap="round"/><path d="M16 12l4 4-4 4M20 16H14" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</div>
					<h3>Planificación y relevamiento</h3>
					<p>Cargamos el polígono del lote en el sistema de vuelo autónomo. El drone mapea y planifica la trayectoria óptima con GPS RTK.</p>
				</div>
				<div class="step-card reveal">
					<div class="step-number">02</div>
					<div class="step-dot">
						<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="white" stroke-width="1.8"/><path d="M8 12l3 3 5-5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</div>
					<h3>Configuración del dron</h3>
					<p>Cargamos el producto fitosanitario, fertilizante o semilla. Calibramos la dosis y el caudal según la prescripción agronómica del lote.</p>
				</div>
				<div class="step-card reveal">
					<div class="step-number">03</div>
					<div class="step-dot">
						<svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12l7-7 7 7" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</div>
					<h3>Vuelo autónomo de precisión</h3>
					<p>El DJI Agras T100 despega y aplica el producto en forma uniforme, manteniendo altura constante sobre el canopeo. Sin superposiciones ni faltantes.</p>
				</div>
				<div class="step-card reveal">
					<div class="step-number">04</div>
					<div class="step-dot">
						<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="3" stroke="white" stroke-width="1.8"/><path d="M9 12l2 2 4-4" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</div>
					<h3>Reporte y trazabilidad</h3>
					<p>Al finalizar entregamos un reporte de vuelo con track GPS, producto aplicado, dosis y caudal. Total trazabilidad para tu gestión agronómica.</p>
				</div>
			</div>

			<!-- Drone specs -->
			<div class="drone-specs reveal">
				<div class="drone-specs-text">
					<h3>DJI AGRAS T100</h3>
					<p>El drone agrícola más avanzado disponible. Diseñado para máxima eficiencia en grandes extensiones con tecnología de punta.</p>
				</div>
				<div class="drone-specs-grid">
					<div class="spec-item">
						<span class="spec-value">40L</span>
						<span class="spec-label">Capacidad tanque</span>
					</div>
					<div class="spec-item">
						<span class="spec-value">100ha</span>
						<span class="spec-label">Por jornada</span>
					</div>
					<div class="spec-item">
						<span class="spec-value">±10cm</span>
						<span class="spec-label">Precisión GPS RTK</span>
					</div>
					<div class="spec-item">
						<span class="spec-value">8 mts</span>
						<span class="spec-label">Ancho de labor</span>
					</div>
					<div class="spec-item">
						<span class="spec-value">12L/min</span>
						<span class="spec-label">Caudal máximo</span>
					</div>
					<div class="spec-item">
						<span class="spec-value">Auto</span>
						<span class="spec-label">Vuelo autónomo</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="relative w-full h-screen">
  <!-- Imagen fullscreen -->
  <img 
    src="/dronFumigando.webp" 
    alt="Dron fumigando un campo al atardecer" 
    class="absolute inset-0 w-full h-full object-cover"
  >

  <!-- Overlay oscuro -->
  <div class="absolute inset-0 bg-black/50"></div>
</section>


	<!-- ─── ABOUT ─── -->
	<section id="nosotros">
	<div class="container">
		<div class="about-grid">
		<div class="about-visual reveal">
			<div class="about-card-main">
			<h3>Río Segundo,<br>Córdoba</h3>
			<p>Somos un equipo apasionado por la agricultura de precisión, radicados en el corazón productivo de la Provincia de Córdoba. Combinamos el conocimiento agronómico local con la tecnología más avanzada del mundo en drones agrícolas.</p>
			<div class="about-location">
				<svg viewBox="0 0 16 16" fill="none"><path d="M8 1C5.24 1 3 3.24 3 6c0 3.75 5 9 5 9s5-5.25 5-9c0-2.76-2.24-5-5-5zm0 6.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3z" fill="#41b3f5"/></svg>
				Río Segundo, Córdoba, Argentina
			</div>
			</div>
			<div class="about-float-badge">
			⭐ Operadores<br>certificados DJI
			</div>
		</div>
		<div class="about-text reveal">
			<span class="section-label">Quiénes somos</span>
			<h2 class="section-title">EXPERIENCIA Y <span class="accent">TECNOLOGÍA</span> AL SERVICIO DEL CAMPO</h2>
			<p>En AgroEvolution creemos que el futuro de la agricultura argentina pasa por la tecnología. Por eso invertimos en los mejores equipos y en la capacitación continua de nuestros operadores.</p>
			<p>Trabajamos con productores de toda la región central de Córdoba, ofreciendo un servicio personalizado, con asesoramiento agronómico previo a cada aplicación y seguimiento post-tratamiento.</p>
			<div class="values-list">
			<div class="value-item"><span class="value-dot"></span>Operadores certificados y capacitados</div>
			<div class="value-item"><span class="value-dot"></span>Equipos DJI de última generación</div>
			<div class="value-item"><span class="value-dot"></span>Asesoramiento agronómico incluido</div>
			<div class="value-item"><span class="value-dot"></span>Compromiso con el medioambiente</div>
			<div class="value-item"><span class="value-dot"></span>Cobertura en toda la región de Córdoba</div>
			</div>
			<a href="#contacto" class="btn-primary" style="margin-top:2rem; display:inline-flex;">
			Trabajar con nosotros →
			</a>
		</div>
		</div>
	</div>
	</section>

	<!-- ─── CONTACT ─── -->
	<section id="contacto">
	<div class="container">
		<div class="reveal centered">
		<span class="section-label" style="color:var(--green-bright)">Contacto</span>
		<h2 class="section-title" style="color:#fff">¿LISTO PARA <span style="color:var(--green-bright)">VOLAR</span>?</h2>
		<p class="section-subtitle" style="color:rgba(255,255,255,0.6)">Contanos sobre tu campo y te preparamos una cotización sin cargo. Respondemos en menos de 24 horas.</p>
		</div>

		<div class="contact-grid">
		<div class="contact-info reveal">
			<h3>Hablemos hoy</h3>
			<p>Atendemos consultas de lunes a sábado. Podés contactarnos por WhatsApp para una respuesta inmediata, o completar el formulario y te llamamos nosotros.</p>
			<div class="contact-methods">
