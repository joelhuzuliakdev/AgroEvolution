    .mobile-menu a:hover { color: var(--green-bright); }

    /* ── HERO ── */
    #hero {
		position: relative;
		min-height: 100vh;
		display: flex; align-items: center; justify-content: center;
		overflow: hidden;
		background: linear-gradient(135deg, var(--blue-deep) 0%, var(--green-deep) 60%, #0d2b14 100%);
    }
    .hero-grid-overlay {
		position: absolute; inset: 0;
		background-image:
			linear-gradient(rgba(39,196,95,0.07) 1px, transparent 1px),
			linear-gradient(90deg, rgba(39,196,95,0.07) 1px, transparent 1px);
